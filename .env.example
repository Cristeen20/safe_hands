# Postgres. Locally any Postgres works; in Vercel this comes from the Neon
# Marketplace integration (use the pooled connection string).
DATABASE_URL=postgres://postgres@localhost:54329/safe_hands

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally; the button is hidden without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS (required in production; dev logs codes to the console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend email (required in production; dev logs codes to the console).
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Absolute site URL for links in emails (defaults to BETTER_AUTH_URL).
APP_URL=

# Local only: set to 1 to enable /api/dev/admin-login (ignored outside `next dev`).
DEV_ADMIN_LOGIN=

# Google Maps Platform (optional locally). Without them, addresses are plain
# text and hospital-visit/driver requests go to an admin for a quote.
# Server key: Routes API + Geocoding API (keep it server-only).
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API + Places API (New) + Geocoding; restrict it to our domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
